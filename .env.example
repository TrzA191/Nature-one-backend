# Servidor local de Strapi
HOST=0.0.0.0
PORT=1337

# Claves de la Aplicación y Seguridad (Generar valores aleatorios seguros de 32 bytes)
APP_KEYS="clave1,clave2,clave3,clave4"
API_TOKEN_SALT=token_salt_aleatorio
ADMIN_JWT_SECRET=admin_jwt_secret_aleatorio
TRANSFER_TOKEN_SALT=transfer_token_salt_aleatorio
JWT_SECRET=jwt_secret_aleatorio
ENCRYPTION_KEY=encryption_key_aleatorio

# Integración con el Frontend (URL del cliente de Next.js)
CLIENT_URL=http://localhost:3000

# Integración con Stripe (Llave secreta de Stripe para desarrollo, inicia con sk_test_...)
STRIPE_KEY=sk_test_tu_llave_secreta_aqui

# Configuración de Cloudinary (Opcional, dejar con 'Root' para usar almacenamiento local de Strapi)
CLOUDINARY_NAME=Root
CLOUDINARY_KEY=tu_cloudinary_key_aqui
CLOUDINARY_SECRET=tu_cloudinary_secret_aqui
